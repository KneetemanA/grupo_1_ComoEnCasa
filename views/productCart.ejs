<!DOCTYPE html>
<html lang="es">
<%- include ("./partials/head",{title: "Carrito de compras",bootstrapActive: true})%>
<body>
    <%- include ("./partials/header") %>
    <main class="productCart">
        <div class="titulo-pagina">
            <i class="fa-solid fa-cart-shopping"></i>
            <h2>Carrito de compras</h2>
        </div>
        <div class="mainCarrito">
            <section class="section-product">
                <div class="container-table">
                    <table class="table cart-items">
                        <thead>
                            <tr>
                                <th>Productos</th>
                                <th class="descripcion"></th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <div id="container-card">
                        <tbody>
                           <!-- ... CARDS ... -->
                        </tbody>
                        </div>
                        
                    </table>
                    <div class="text-end">
                        <span class="btn btn-danger" id="boton-vaciar">
                            Vaciar Carrito
                        </span>
                    </div>
                </div>
            </section>
            <section class="section-total">
                <div class="container-table-total">
                    <h3 class="total">Resumen de la compra</h3>
                    <table>
                        <tbody>
                            <tr>
                                <td>Subtotal</td>
                                <td>$2000</td>
                            </tr>
                            <tr>
                                <td>Descuento</td>
                                <td>$0</td>
                            </tr>
                            <tr>
                                <td>Total</td>
                                <td>$2000</td>
                            </tr>
                        </tbody>
                    </table>
                    <div>
                        <span class="btn btn-primary" id="boton-comprar" >
                            <a href="#">Comprar</a>
                        </span>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <%- include ("./partials/footer") %>

    <script src="../public/js/cart/"></script>
</body>
</html>
