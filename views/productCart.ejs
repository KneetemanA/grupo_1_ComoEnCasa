<!DOCTYPE html>
<html lang="es">
<%- include ("./partials/head",{title: "Carrito de compras",bootstrapActive: true})%>
<body>
    <%- include ("./partials/header") %>
    <main class="productCart">
        <div class="titulo-pagina">
            <i class="fa-solid fa-cart-shopping"></i>
            <h2>Carrito de compras</h2>
        </div>
        <div class="mainCarrito">
            <section class="section-product">
                <div class="container-table">
                    <table class="table cart-items">
                        <thead>
                            <tr>
                                <th>Productos</th>
                                <th class="descripcion"></th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="container-detail">
                                <td class="td-img"><img src="/images/default.jpg" alt="imagen-producto"></td>
                                <td class="td-name">Lorem ipsum dolor sit amet consectetur adipisicing elit. Necessitatibus.</td>
                                <td class="td-price">2000</td>
                                <td class="td-cantidad">1</td>                                
                                <td class="td-total">2000</td>
                                <td class="td-borrar"><i class="fa-solid fa-trash boton-borrar"></i></td>
                            </tr>
                            <tr class="container-detail">
                                <td class="td-img"><img src="/images/default.jpg" alt="imagen-producto"></td>
                                <td class="td-name">Lorem ipsum dolor sit amet consectetur adipisicing elit.</td>
                                <td class="td-price">2000</td>
                                <td class="td-cantidad">1</td>
                                <td class="td-total">2000</td>
                                <td class="td-borrar"><i class="fa-solid fa-trash boton-borrar"></i></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-end">
                        <span class="btn btn-danger boton-vaciar">
                            <a href="#">Vaciar Carrito</a>
                        </span>
                    </div>
                </div>
            </section>
            <section class="section-total">
                <div class="container-table-total">
                    <h3 class="total">Resumen de la compra</h3>
                    <table>
                        <tbody>
                            <tr>
                                <td>Subtotal</td>
                                <td>$2000</td>
                            </tr>
                            <tr>
                                <td>Descuento</td>
                                <td>$0</td>
                            </tr>
                            <tr>
                                <td>Total</td>
                                <td>$2000</td>
                            </tr>
                        </tbody>
                    </table>
                    <div>
                        <span class="btn btn-primary boton-comprar">
                            <a href="#">Ir a pagar</a>
                        </span>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <%- include ("./partials/footer") %>
    <script src="../public/js/cart/cart.js"></script>
</body>
</html>
