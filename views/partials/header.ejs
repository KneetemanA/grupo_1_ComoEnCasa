<header>
    <div class="partSup">
      <a class="primerAheader" href="/"><img class="logoHeader" src="/images/logo.png" alt="logo"></a>
      <i class="fas fa-bars hamb1"></i>
      <div class="logueoHeader">
        <nav>
            
            <ul>
              <% if (!locals.userlogueado) { %>
                <li><a href="#" id="modal-carrito"><i class="fas fa-cart-plus carritoHeader"></i></a></li>
                <li><a href="/user/login"><i class="fa-regular fa-heart coraHeader"></i></a></li>
                <li><a href="/user/register"><i class="fa-regular fa-user userHeader"></i></a></li>
                
              <% } else { %>
                <li><a href="#" id="modal-carrito"><i class="fas fa-cart-plus carritoHeader"></i></a></li>
                <li><a href="/admin"><i class="fa-solid fa-gear ruedaHeader"></i></a></li>
                <li><a href="/user/perfil/<%=locals.userlogueado.id%>">PERFIL</a></li>
              <%}%></ul>

        </nav>
      </div>
    </div>
    <div class="partInf">
      <nav class="navHeader2">
        <ul class="ulInf">
          <button type="button" class="verMenu"><i class="fas fa-bars hamb2"></i> Ver menú</button>
          <li><a href="/productos#papas"> Papas</a></li>
          <li><a href="/productos#pizza"> Pizzas</a></li>
          <li><a href="/productos#hamburguesa"> Hamburguesas</a></li>
          
        </ul>
      </nav>
      <div class="divBusquedaHeader">
        <form action="/search" method="get">
          <input type="text" name="productoBuscado" placeholder="Buscar productos" value="">
          <button value="search" type="submit"><i class="fas fa-search lupaHeader"></i></button >
        </form>
      </div>
    </div>
    <div class="modalc" id="modalCarrito">
      <div class="modal-contenido">
        <span class="closeModal"><i class="fa-solid fa-circle-xmark fs-1"></i></span>
        <div class="modalc-header mb-3">
          <span> <i class="fa-solid fa-cart-shopping fs-2"></i></span>
          <h2>Carrito de compras</h2>
          
        </div>
        <div class="modalc-body">
          <div class="product-item d-flex justify-content-between align-items-center p-2 my-2 bg-white rounded shadow-sm">
            <div class="d-flex align-items-center">
              <img class="product-image me-2 rounded" src="/images/default.jpg" alt="Product image">
              <span class="product-name fs-6 fw-semibold ">Pizza Muzza</span>
            </div>
            <div class="d-flex align-items-center gap-2 agregar-items rounded shadow-sm bg-light">
              <button class="btn bg-secondary btn-sm  fw-bold fs-6 boton-agregar-restar  rounded   ">-</button>
              <span class="quantity fs-5 fw-bold ">1</span>
              <button class="btn bg-primary btn-sm  fw-bold fs-6 boton-agregar-restar rounded ">+</button>
              <button class="btn btn-outline-danger bg-danger btn-sm fs-6 ms-1 boton-agregar-restar rounded ">
                <i class="fas fa-trash fs-6"></i>
              </button>
            </div>
          </div>
          <div class="product-item d-flex justify-content-between align-items-center p-2 my-3 bg-white rounded shadow-sm">
            <div class="d-flex align-items-center">
              <img class="product-image me-2 rounded" src="/images/default.jpg" alt="Product image">
              <span class="product-name fs-6 fw-semibold ">Pizza Muzza</span>
            </div>
            <div class="d-flex align-items-center gap-2 agregar-items rounded shadow-sm bg-light">
              <button class="btn bg-secondary btn-sm  fw-bold fs-6 boton-agregar-restar  rounded   ">-</button>
              <span class="quantity fs-5 fw-bold ">1</span>
              <button class="btn bg-primary btn-sm  fw-bold fs-6 boton-agregar-restar rounded ">+</button>
              <button class="btn btn-outline-danger bg-danger btn-sm fs-6 ms-1 boton-agregar-restar rounded ">
                <i class="fas fa-trash fs-6"></i>
              </button>
            </div>
          </div>
          <a href="/carrito" class="btn btn-primary">Ir a pagar</a>
        </div>
      </div>
    </div>

    <script src="/js/modal-carrito.js"></script>
    <script src="/js/cart/cart.js"></script>
  </header>